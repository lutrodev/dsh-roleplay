{
  "name": "dsh-roleplay-rp-library",
  "version": "0.1.7",
  "description": "Roleplay asset navigation, session binding and Prompt UI for Roleplay",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./session-bootstrap": "./src/session-bootstrap.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js",
    "src/**/*.css",
    "dist/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check src/session-bootstrap.js && node --check src/deletion.js && node --check src/client.js && node --check src/session-wiki.js && node --check src/session-binding.js && node --check src/client-state.js && node --check src/run-marker.js && node --check src/asset-editor-registry.js && node --check src/context-canvas.js && node --check src/prompt-custom-source.js && node --check src/prompt-slot-visibility.js",
    "test": "node --test",
    "generate:styles": "node scripts/generate-styles.mjs",
    "build:client": "pnpm run generate:styles && tsdown --config tsdown.config.js --config-loader native",
    "verify": "pnpm run check && pnpm test && pnpm run build:client"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "dsh-roleplay-rp-remote"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "motion": "12.43.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-agent-presets": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "^0.1.2-alpha.2",
    "dsh-roleplay-rp-macro": "^0.1.0",
    "dsh-roleplay-rp-session": "^0.1.0",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.1.2-alpha.2",
    "dsh-roleplay-rp-remote": "^0.1.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-alpha.2",
    "dsh-roleplay-rp-character-card": "workspace:^",
    "dsh-roleplay-rp-lore-book": "workspace:^",
    "dsh-roleplay-rp-macro": "workspace:^",
    "dsh-roleplay-rp-persona": "workspace:^",
    "dsh-roleplay-rp-preset": "workspace:^",
    "dsh-roleplay-rp-session": "workspace:^",
    "dsh-roleplay-rp-ui": "workspace:^",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.2-alpha.2",
    "dsh-roleplay-rp-remote": "workspace:^"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.23.0"
}
