{
  "name": "dsh-roleplay-rp-dialogue-highlight",
  "version": "0.1.7-alpha",
  "description": "Roleplay dialogue text highlighting during streaming and finalized assistant output",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js",
    "src/**/*.css",
    "dist/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check src/client.js && node --check src/dialogue-ranges.js && node --check src/dom-highlight.js",
    "test": "node --test",
    "generate:styles": "node scripts/generate-styles.mjs",
    "build:client": "pnpm run generate:styles && tsdown --config tsdown.config.js --config-loader native",
    "verify": "pnpm run check && pnpm test && pnpm run build:client"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.2",
    "react": "18.3.1",
    "tsdown": "0.22.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.2",
    "dsh-roleplay-rp-ui": "workspace:^"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.23.0"
}
