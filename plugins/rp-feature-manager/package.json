{
  "name": "dsh-roleplay-rp-feature-manager",
  "version": "0.1.7",
  "description": "Settings-based feature, Skill, and version management for the bundled Roleplay suite",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./catalog": "./src/catalog.js",
    "./selection": "./src/selection.js",
    "./version": "./src/version.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js",
    "src/**/*.css",
    "dist/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check src/catalog.js && node --check src/selection.js && node --check src/version.js && node --check src/client.js && node --check src/client-state.js && node --check src/quick-reply-settings.js && node --check src/reply-options-settings.js",
    "test": "pnpm run test:node && pnpm run test:client",
    "test:node": "node --test test/*.test.js",
    "test:client": "vitest run test/client.client.spec.jsx",
    "generate:styles": "node scripts/generate-styles.mjs",
    "build:client": "pnpm run generate:styles && tsdown --config tsdown.config.js --config-loader native",
    "verify": "pnpm run check && pnpm test && pnpm run build:client"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "dsh-roleplay-rp-remote"
      ],
      "platform": "web"
    },
    "roleplay": {
      "suiteVersion": "0.1.7",
      "requiresDsh": "0.1.2-alpha.3"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "motion": "12.43.0",
    "dsh-roleplay-rp-remote": "workspace:^",
    "dsh-roleplay-rp-compact-access-mode": "workspace:^",
    "dsh-roleplay-rp-standard": "workspace:^",
    "dsh-roleplay-rp-conversation-summary": "workspace:^",
    "dsh-roleplay-rp-core": "workspace:^",
    "dsh-roleplay-rp-subagent-manager": "workspace:^",
    "dsh-roleplay-rp-session": "workspace:^",
    "dsh-roleplay-rp-character-card": "workspace:^",
    "dsh-roleplay-rp-state": "workspace:^",
    "dsh-roleplay-rp-compat-mvu": "workspace:^",
    "dsh-roleplay-rp-lore-book": "workspace:^",
    "dsh-roleplay-rp-persona": "workspace:^",
    "dsh-roleplay-rp-macro": "workspace:^",
    "dsh-roleplay-rp-preset": "workspace:^",
    "dsh-roleplay-rp-writing-style": "workspace:^",
    "dsh-roleplay-rp-asset-tools": "workspace:^",
    "dsh-roleplay-rp-library": "workspace:^",
    "dsh-roleplay-rp-message-actions": "workspace:^",
    "dsh-roleplay-rp-state-display": "workspace:^",
    "dsh-roleplay-rp-reply-options": "workspace:^",
    "dsh-roleplay-rp-message-avatar": "workspace:^",
    "dsh-roleplay-rp-quick-replies": "workspace:^",
    "dsh-roleplay-rp-dialogue-highlight": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.3",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-alpha.3",
    "dsh-roleplay-rp-remote": "^0.1.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.3",
    "jsdom": "29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "vitest": "4.1.8",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.3",
    "dsh-roleplay-rp-remote": "workspace:^"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.23.0"
}
