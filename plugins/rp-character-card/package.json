{
  "name": "dsh-roleplay-rp-character-card",
  "version": "0.1.7-alpha",
  "description": "Community character-card library and importer for Roleplay",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./character-card": "./src/character-card.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js",
    "src/**/*.css",
    "skills/**",
    "dist/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check src/character-card.js && node --check src/library.js && node --check src/service.js && node --check src/client.js && node --check src/client-state.js",
    "test": "node --test",
    "generate:styles": "node scripts/generate-styles.mjs",
    "build:client": "pnpm run generate:styles && tsdown --config tsdown.config.js --config-loader native",
    "verify": "pnpm run check && pnpm test && pnpm run build:client"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "dsh-roleplay-rp-library",
        "dsh-roleplay-rp-remote"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "motion": "12.43.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-fs": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.2",
    "dsh-roleplay-rp-core": "^0.1.0",
    "dsh-roleplay-rp-library": "^0.1.0",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-alpha.2",
    "dsh-roleplay-rp-remote": "^0.1.7-alpha"
  },
  "peerDependenciesMeta": {
    "dsh-roleplay-rp-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-fs": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.2",
    "dsh-roleplay-rp-core": "workspace:^",
    "dsh-roleplay-rp-library": "workspace:^",
    "dsh-roleplay-rp-ui": "workspace:^",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.2",
    "dsh-roleplay-rp-remote": "workspace:^"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.23.0"
}
