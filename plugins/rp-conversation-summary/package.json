    "@deepseek-ai/dsh-compaction": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-compaction-basic": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.1",
    "@deepseek-ai/dsh-token-meter": "^0.1.2-alpha.1",
    "dsh-roleplay-rp-core": "^0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-compaction": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-compaction-basic": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-token-meter": "0.1.2-alpha.1",
    "dsh-roleplay-rp-core": "workspace:^"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.23.0"
