{
  "name": "dsh-roleplay-rp-conversation-summary",
  "version": "0.1.7",
  "description": "Deferred narrative-history compaction and active summary context for Roleplay",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./bridge": "./src/bridge.js",
    "./summary-source": "./src/summary-source.js",
    "./summarizer": "./src/summarizer.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check src/engine.js && node --check src/summarizer.js && node --check src/summary-source.js && node --check src/token-meter.js && node --check src/bridge.js",
    "test": "node --test",
    "verify": "pnpm run check && pnpm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
